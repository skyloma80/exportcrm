NODE_ENV=production
NEXT_PUBLIC_POCKETBASE_URL=http://42.194.150.84:8091
NEXT_PUBLIC_USE_POCKETBASE=true
USE_POCKETBASE=true
DATABASE_PROVIDER=pocketbase


# S3 存储配置 (MinIO) - 服务端变量，用 Docker 内部网络
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://42.194.150.84:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=exportcrm
S3_SECRET_KEY=exportcrm2025
S3_BUCKET=documents
S3_FORCE_PATH_STYLE=true

# S3 公开访问 URL (用于邮件中的图片) - 客户端变量，用外部访问地址
NEXT_PUBLIC_S3_PUBLIC_URL=http://42.194.150.84:9000/public
