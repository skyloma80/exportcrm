# ===========================================
# ExportCRM Configuration
# 外贸出口客户关系管理系统配置
# ===========================================

# ===========================================
# PocketBase Configuration
# ===========================================
# PocketBase server URL
NEXT_PUBLIC_POCKETBASE_URL=http://localhost:8092

# ===========================================
# S3 Storage Configuration
# ===========================================
# S3-compatible storage for file management
# Supports: MinIO (local), AWS S3, 腾讯云 COS, 阿里云 OSS 等

# S3 endpoint URL
# - Local (MinIO): http://localhost:9000
# - AWS S3: https://s3.amazonaws.com or https://s3.<region>.amazonaws.com
# - 腾讯云 COS: https://cos.<region>.myqcloud.com
# - 阿里云 OSS: https://<region>.aliyuncs.com
S3_ENDPOINT=http://localhost:9000

# AWS region
S3_REGION=us-east-1

# S3 access credentials
S3_ACCESS_KEY=exportcrm
S3_SECRET_KEY=exportcrm2025

# Bucket name
S3_BUCKET=exportcrm-documents

# URL style configuration
# - true: Path-style URLs (MinIO, 部分 S3 兼容服务需要)
# - false: Virtual-hosted-style URLs (AWS S3, 腾讯云 COS, 阿里云 OSS)
S3_FORCE_PATH_STYLE=true

# ===========================================
# Exchange Rate API Configuration
# 汇率 API 配置
# ===========================================
# Exchange rate API provider (exchangerate-api, fixer, openexchangerates)
EXCHANGE_RATE_PROVIDER=exchangerate-api

# API key for exchange rate service (if required)
# EXCHANGE_RATE_API_KEY=your_api_key_here

# Base currency for exchange rates (default: USD)
EXCHANGE_RATE_BASE_CURRENCY=USD

# ===========================================
# AI Agent Configuration (Optional)
# AI 代理配置（可选）
# ===========================================
# Enable AI features (true/false)
AI_ENABLED=false

# AI provider (openai, anthropic, azure-openai)
# AI_PROVIDER=openai

# AI API key
# AI_API_KEY=your_api_key_here

# AI model name
# AI_MODEL=gpt-4

# ===========================================
# Page Agent Configuration (Browser Form Automation)
# 浏览器表单自动填充，用于需要用户确认的操作
# ===========================================
# CRM frontend URL (Next.js app, default: http://42.194.150.84:3333)
# CRM_FRONTEND_URL=http://localhost:3333

# Page Agent mode: "demo" (free test API) or "production" (own LLM)
# PAGE_AGENT_MODE=demo

# Production mode requires an LLM API key
# PAGE_AGENT_API_KEY=your_api_key_here
# PAGE_AGENT_MODEL=qwen3.5-plus
# PAGE_AGENT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ===========================================
# Email Configuration (for Hermes agent)
# ===========================================
# SMTP server for sending branded emails
CRM_SMTP_HOST=smtp.example.com
CRM_SMTP_PORT=587
CRM_SMTP_USER=user@example.com
CRM_SMTP_PASS=yourpassword
CRM_SMTP_FROM="Alustars <c.feliu@alustars.com>"
CRM_SMTP_USE_TLS=true

# Logo public URL (used in email HTML, must be publicly accessible)
CRM_LOGO_URL=http://42.194.150.84:9001/api/v1/buckets/public/objects/download?preview=true&prefix=logo.png&version_id=null

# Branding info for email signature
CRM_COMPANY_NAME="ALUSTARS INTERNATIONAL CO., LTD"
CRM_SIGNER_NAME="Carlos Feliu"
CRM_SIGNER_TITLE="VP of Business Development"
CRM_COMPANY_ADDRESS="Valencia 264 Principal, 08007 Barcelona (Spain)"
CRM_COMPANY_PHONE="(+34) 607630594"
CRM_COMPANY_EMAIL="c.feliu@alustars.com"
CRM_WEBSITE_URL=www.alustars.com

# ===========================================
# Application Settings
# 应用设置
# ===========================================
# Default locale (en, zh)
NEXT_PUBLIC_DEFAULT_LOCALE=zh

# Default currency
NEXT_PUBLIC_DEFAULT_CURRENCY=USD

# ===========================================
# Page Agent Configuration (Embedded AI Copilot)
# 内置 AI 助手配置（Next.js 前端使用）
# ===========================================
# Page Agent LLM configuration (for the embedded CRM AI copilot)
# NEXT_PUBLIC_PAGE_AGENT_MODEL=qwen3.5-plus
# NEXT_PUBLIC_PAGE_AGENT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# NEXT_PUBLIC_PAGE_AGENT_API_KEY=your_api_key_here
