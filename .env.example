# ===========================================
# ExportCRM Configuration
# 外贸出口客户关系管理系统配置
# ===========================================

# ===========================================
# PocketBase Configuration
# ===========================================
# PocketBase server URL
NEXT_PUBLIC_POCKETBASE_URL=http://localhost:8092

# ===========================================
# S3 Storage Configuration
# ===========================================
# S3-compatible storage for file management
# Supports: MinIO (local), AWS S3, 腾讯云 COS, 阿里云 OSS 等

# S3 endpoint URL
# - Local (MinIO): http://localhost:9000
# - AWS S3: https://s3.amazonaws.com or https://s3.<region>.amazonaws.com
# - 腾讯云 COS: https://cos.<region>.myqcloud.com
# - 阿里云 OSS: https://<region>.aliyuncs.com
S3_ENDPOINT=http://localhost:9000

# AWS region
S3_REGION=us-east-1

# S3 access credentials
S3_ACCESS_KEY=exportcrm
S3_SECRET_KEY=exportcrm2025

# Bucket name
S3_BUCKET=exportcrm-documents

# URL style configuration
# - true: Path-style URLs (MinIO, 部分 S3 兼容服务需要)
# - false: Virtual-hosted-style URLs (AWS S3, 腾讯云 COS, 阿里云 OSS)
S3_FORCE_PATH_STYLE=true

# ===========================================
# Exchange Rate API Configuration
# 汇率 API 配置
# ===========================================
# Exchange rate API provider (exchangerate-api, fixer, openexchangerates)
EXCHANGE_RATE_PROVIDER=exchangerate-api

# API key for exchange rate service (if required)
# EXCHANGE_RATE_API_KEY=your_api_key_here

# Base currency for exchange rates (default: USD)
EXCHANGE_RATE_BASE_CURRENCY=USD

# ===========================================
# AI Agent Configuration (Optional)
# AI 代理配置（可选）
# ===========================================
# Enable AI features (true/false)
AI_ENABLED=false

# AI provider (openai, anthropic, azure-openai)
# AI_PROVIDER=openai

# AI API key
# AI_API_KEY=your_api_key_here

# AI model name
# AI_MODEL=gpt-4

# ===========================================
# Application Settings
# 应用设置
# ===========================================
# Default locale (en, zh)
NEXT_PUBLIC_DEFAULT_LOCALE=zh

# Default currency
NEXT_PUBLIC_DEFAULT_CURRENCY=USD
